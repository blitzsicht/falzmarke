{
  "manifest_version": 2,
  "name": "falzmarke Entwurfsbrücke",
  "description": "Öffnet Entwürfe auf Zuruf von falzmarke wie „Entwurf bearbeiten“, hält fest, was aus ihnen wurde, und fragt nach, bevor dieselbe Mail ein zweites Mal hinausgeht. Senden kann es nicht.",
  "version": "0.3.4",
  "browser_specific_settings": {
    "gecko": {
      "id": "entwurfsbruecke@falzmarke",
      "strict_min_version": "158.0",
      "update_url": "https://github.com/blitzsicht/falzmarke/releases/latest/download/updates.json"
    }
  },
  "permissions": ["compose", "messagesRead", "accountsRead"],
  "background": {
    "scripts": ["zeichennamen.js", "vergleich.js", "background.js"]
  },
  "experiment_apis": {
    "entwurfsbruecke": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["entwurfsbruecke"]],
        "script": "implementation.js"
      }
    }
  }
}
