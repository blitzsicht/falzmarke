{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.blitzsicht/falzmarke",
  "title": "falzmarke",
  "description": "Am fertigen PDF nachgemessen: DIN-5008-Briefe aus Markdown. Sollwerte aus Sekundärquellen.",
  "version": "0.11.2",
  "repository": {
    "url": "https://github.com/blitzsicht/falzmarke",
    "source": "github"
  },
  "websiteUrl": "https://falzmarke.com",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "falzmarke",
      "version": "0.11.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "mcp~=2.0"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
